          'returnedByDriverName',
          'deliveryDriverId',
          'deliveryDriverName',
          'deliverySectorId',
          'deliverySectorCode',
          'deliverySectorName',
          'deliveryVehicleId',
          'deliveryVehicleLabel',
          'deliveryAssignedAt',
          'deliveryAssignedBy'
        ]);
      // ⚠️ Ce bloc est volontairement très large (retours, corrections diverses par le staff).
      // Comme il ne restreint pas explicitement les champs 'controlled'/'deliveryControlled',
      // il laissait n'importe quel membre du staff écraser le pointage Encaisseur Central d'un
