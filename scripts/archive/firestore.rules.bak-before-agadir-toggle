rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() ? userDoc().role : null;
    }

    function isStaff() {
      return role() == 'admin' || role() == 'directeur' || role() == 'agent'
          || role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation') || role() == 'caissier'
          || role() == 'aide_agent' || role() == 'pointeur_encaisseur'
          || role() == 'encaisseur_central' || role() == 'distributeur_especes'
          || role() == 'distributeur_cheques' || role() == 'facturier'
          || role() == 'analyseur_cheque' || role() == 'analyseur_espece';
    }

    function isFacturier() {
      return role() == 'facturier';
    }

    function isPointeurEncaisseur() {
      return role() == 'pointeur_encaisseur';
    }

    function isCentralCollector() {
      return role() == 'encaisseur_central';
    }

    function isDistributeurEspeces() {
      return role() == 'distributeur_especes';
    }

    function isDistributeurCheques() {
      return role() == 'distributeur_cheques';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isAdminOrDirecteur() {
      return role() == 'admin' || role() == 'directeur';
    }

    function isAgentOrChef() {
      return role() == 'agent' || role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation');
    }

    function isChefAgence() {
      return role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation');
    }

    function isAideAgent() {
      return role() == 'aide_agent';
    }

    function isDeliveryWorker() {
      // Canonical roles only â€” normalize at write time in app code
      return role() == 'chauffeur' || role() == 'livreur';
    }

    function isNotBlocked() {
      // ⚠️ .get() : la plupart des fiches utilisateur n'ont PAS de champ 'blocked' ;
      // userDoc().blocked levait alors une erreur d'évaluation et REFUSAIT toute règle
      // utilisant isNotBlocked() (ex. correction du bon par agent / chef d'agence).
      return userDoc().get('blocked', false) != true;
    }

    function userCity() {
      return signedIn() && userDoc().city is string ? userDoc().city : '';
    }

    function isAdminOrSameCity(city) {
      return isAdmin() || userCity() == city;
    }

    function isParcelCreator() {
      return signedIn() && resource.data.agentId == request.auth.uid;
    }

    function isChefOfAideAgentParcelAgency() {
      return (role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation'))
        && (resource.data.agentRole == 'aide_agent' || resource.data.agentRole == 'client_portal')
        && (
          resource.data.originCity == userDoc().city
          || (resource.data.sender != null && resource.data.sender.city == userDoc().city)
          || (
            resource.data.agentId is string
            && exists(/databases/$(database)/documents/users/$(resource.data.agentId))
            && get(/databases/$(database)/documents/users/$(resource.data.agentId)).data.role == 'aide_agent'
            && get(/databases/$(database)/documents/users/$(resource.data.agentId)).data.city == userDoc().city
          )
        );
    }

    function protectedParcelBonFields() {
      return [
        'trackingId',
        'sender',
        'receiver',
        'weight',
        'nbColis',
        'natureOfGoods',
        'serviceType',
        'customerMode',
        'price',
        'codAmount',
        'codMixed',
        'codCashAmount',
        'agentId',
        'agentName',
        'originCity',
        'destinationCity',
        'clientId',
        'clientName',
        'createdAt'
      ];
    }

    function parcelCorrectionFields() {
      return [
        'sender',
        'receiver',
        'originCity',
        'destinationCity',
        'weight',
        'nbColis',
        'natureOfGoods',
        'serviceType',
        'customerMode',
        'price'
      ];
    }

    function parcelSearchFields() {
      // Champs dénormalisés de recherche (recalculés quand expéditeur / destinataire change)
      return ['senderNic', 'senderTel', 'receiverTel', 'senderNameLower', 'receiverNameLower'];
    }

    function parcelBonEditFields() {
      // Champs modifiables par le modal "Modifier l'expédition" / confirmation après saisie
      return parcelCorrectionFields().concat(parcelSearchFields()).concat([
        'codAmount', 'codAmountHistory', 'codStatus', 'codPaymentType',
        // RF mixte (Espèces + chèque/traite) : mêmes droits que codAmount
        'codMixed', 'codCashAmount',
        'portType', 'fragile', 'notes',
        'lastModifiedBy', 'lastModifiedByName', 'lastModifiedAt'
      ]);
    }

    function deliveryAssignmentFields() {
      return [
        'deliveryDriverId',
        'deliveryDriverName',
        'deliverySectorId',
        'deliverySectorCode',
        'deliverySectorName',
        'deliveryVehicleId',
        'deliveryVehicleLabel',
        'deliveryAssignedAt',
        'deliveryAssignedBy'
      ];
    }

    function aideAgentValidationFields() {
      return [
        'agentId',
        'agentName',
        'agentRole',
        'aideAgentId',
        'aideAgentName',
        'validatedByChef',
        'validatedAt',
        'validatedById',
        'validatedByName',
        'aideEditUnlocked',
        'aideEditLockChangedAt',
        'aideEditLockChangedBy',
        'aideEditLockChangedByName',
        'destinationAgentId',
        'destinationAgentName',
        'deliveryAssignedBy',
        'receiverClientId'
      ];
    }

    function isDestinationAgencyChief() {
      return (role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation'))
        && userDoc().city == resource.data.destinationCity;
    }

    function isAssignedDeliveryWorker() {
      return signedIn()
        && resource.data.deliveryDriverId == request.auth.uid;
    }

    function keepsDeliveredStatus() {
      // Autoriser la transition "Livré" → "Retourné" (retour de colis)
      let isReturnTransition = request.resource.data.status == 'Retourné';
      
      // Bloquer autres changements de statut depuis "Livré"
      let blocksOtherChanges = (resource.data.status == 'Livré' || resource.data.status == 'LivrÃ©')
        && request.resource.data.status != resource.data.status
        && request.resource.data.status != 'Retourné';

      return isReturnTransition || !blocksOtherChanges;
    }

    function ownsClient(clientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && (
          get(/databases/$(database)/documents/clients/$(clientId)).data.portalUid == request.auth.uid
          || userDoc().clientId == clientId
        );
    }


    function isParcelLocked() {
      // 🔒 Un colis est verrouillé s'il a été chargé dans un camion
      return 'shipmentLoadedAt' in resource.data && resource.data.shipmentLoadedAt != null;
    }

    function keepsEnComptePortType() {
      // 💼 Si le colis était "en compte", le portType ne peut JAMAIS être modifié
      // (sauf par admin) pour éviter les problèmes de comptabilité client
      return resource.data.portType != 'port_en_compte'
        || request.resource.data.portType == 'port_en_compte'
        || isAdmin();
    }

    // 🔒 Pointage Encaisseur Central (Contrôle + Confirmation d'arrivée) : chaque pointage
    // n'appartient qu'à son auteur. Poser un pointage (passer à true) est libre pour tout
    // Encaisseur Central UNIQUEMENT si le colis n'est pas déjà pointé (premier arrivé) ;
    // une fois posé, seul son auteur peut le reposer, le modifier ou le retirer — sinon un
    // second utilisateur pouvait écraser silencieusement le pointage du premier en cliquant
    // à nouveau sur "Pointer"/"Confirmer arrivée" après coup.
    function controlOnlyKeys() {
      return ['controlled', 'controlledBy', 'controlledById', 'controlledAt'];
    }
    function deliveryControlOnlyKeys() {
      return ['deliveryControlled', 'deliveryControlledBy', 'deliveryControlledById', 'deliveryControlledAt'];
    }
    // ⚡ Chemin rapide Chef d'agence / Agent Pro / Chef d'exploitation : mêmes conditions que la
    // branche « agent / chef » du grand bloc staff (plus bas), mais évaluée EN PREMIER et avec les
    // champs modifiés calculés une seule fois (limite Firestore de 1000 expressions par requête).
    function chefFastPathUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // Ordre « du moins cher au plus cher » : un refus est décidé tôt, sans épuiser le budget
      // d'expressions nécessaire aux autres règles (correction du bon, etc.).
      return !changed.hasAny(['codAmount', 'codMixed', 'codCashAmount'])
        && (
          !changed.hasAny(protectedParcelBonFields())
          || resource.data.agentId == request.auth.uid
        )
        && !changed.hasAny(aideAgentValidationFields())
        && isChefAgence()
        && (!changed.hasAny(deliveryAssignmentFields()) || resource.data.agentId == request.auth.uid || isDestinationAgencyChief())
        && keepsDeliveredStatus()
        && (!touchesOnlyControlFields() || isOwnControlChange());
    }

    function isOwnControlChange() {
      // ⚠️ resource.data.controlled LÈVE UNE ERREUR (pas juste null) si le champ n'existe pas
      // encore sur le colis — cas du tout premier pointage. .get(clé, défaut) évite ce piège.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        changed.hasOnly(controlOnlyKeys()) && (
          (request.resource.data.controlled == true && resource.data.get('controlled', false) != true)
          || resource.data.get('controlledById', null) == request.auth.uid
        )
      ) || (
        changed.hasOnly(deliveryControlOnlyKeys()) && (
          (request.resource.data.deliveryControlled == true && resource.data.get('deliveryControlled', false) != true)
          || resource.data.get('deliveryControlledById', null) == request.auth.uid
        )
      );
    }
    function touchesOnlyControlFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(controlOnlyKeys()) || changed.hasOnly(deliveryControlOnlyKeys());
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Colis : lecture publique (tracking)
    // codAmount modifiable uniquement par Admin (protection double : rÃ¨gle + code)
    match /parcels/{parcelId} {
      allow get:    if true;
      allow list:   if isStaff() || isFacturier()
        || ownsClient(resource.data.clientId)
        || isDeliveryWorker()
        || (request.query.limit != null && request.query.limit <= 1);
      // ✅ Autoriser les requêtes d'agrégation (count, sum) pour le staff et facturier
      allow read:   if isStaff() || isFacturier();
      allow create: if (signedIn() && request.resource.data.agentId == request.auth.uid)
        || (isStaff() && isNotBlocked())
        || isCentralCollector();  // 📦 Permettre restauration archives
      allow delete: if ((resource.data.status != 'LivrÃ©' && resource.data.status != 'Livr\u00c3\u00a9') || isAdmin()) && (
        isAdmin()
        || isChefOfAideAgentParcelAgency()
        || (isAgentOrChef() && isParcelCreator())
        // 🗑️ Chef d'agence : colis de SON agence saisis par ses AIDE-AGENTS ou ses AGENTS PRO
        // (les siens sont couverts par « créateur » ci-dessus), tant qu'ils ne sont pas chargés dans un camion
        || (role() == 'chef_agence' && !isParcelLocked()
            && (resource.data.get('agentRole', '') == 'aide_agent' || resource.data.get('agentRole', '') == 'agentpro')
            && (resource.data.get('originCity', '') == userCity() || resource.data.get('createdByCity', '') == userCity()))
        || (isAideAgent() && isParcelCreator() && resource.data.validatedByChef != true)
        || (isStaff() && !isAgentOrChef() && !isAideAgent())
      );

      // 🔒 RÈGLE GLOBALE : Admin peut TOUJOURS modifier (même après chargement camion)
      allow update: if isAdmin();

      // ⚡ Chef d'agence / Agent Pro / Chef d'exploitation : statut, remarques, etc. (voir chefFastPathUpdate)
      // ⚡ (déplacée en tête, peu coûteuse) Validation arrivée / colis déjà arrivés — comportement inchangé
      allow update: if signedIn()
        && 'destinationArrivedAt' in request.resource.data
        && 'history' in request.resource.data
        && !touchesOnlyControlFields();
      allow update: if chefFastPathUpdate();
      // ↩️ Annulation d'un retour (chefs) : seulement depuis un colis marqué retourné, vers un état
      // non retourné, avec les seuls champs du retour.
      allow update: if resource.data.get('wasReturned', false) == true
        && request.resource.data.get('wasReturned', true) == false
        && isChefAgence()
        && !(request.resource.data.status in ['Retourné', 'Retour en transit', 'Retour arrivé', 'Retour finalisé', 'Livré'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'history', 'sender', 'receiver', 'senderNameNorm', 'receiverNameNorm',
          'originCity', 'destinationCity', 'returnToCity', 'codAmount', 'codMixed', 'codCashAmount',
          'arrivedNbColis', 'wasReturned', 'preReturn', 'returnedAt', 'returnReason',
          'returnedByDriverId', 'returnedByDriverName', 'returnCancelledAt', 'returnCancelledBy',
          'deliveryDriverId', 'deliveryDriverName', 'deliverySectorId', 'deliverySectorCode',
          'deliverySectorName', 'deliveryVehicleId', 'deliveryVehicleLabel', 'deliveryAssignedAt',
          'deliveryAssignedBy'
        ]);
      // ⚡ Chef de l'agence d'un colis saisi par un aide agent / portail client (même règle que le grand
      // bloc staff), évaluée tôt : test du agentRole d'abord (le moins coûteux).
      allow update: if (resource.data.get('agentRole', '') == 'aide_agent' || resource.data.get('agentRole', '') == 'client_portal')
        && isChefOfAideAgentParcelAgency()
        && keepsDeliveredStatus()
        && (!touchesOnlyControlFields() || isOwnControlChange());

      // ⚡ Placée EN TÊTE (limite de 1000 expressions) : encaissement / statut par le livreur assigné.
      // Livreur local assignÃ© : statut, encaissement, refus et signature uniquement sur ses colis
      allow update: if isAssignedDeliveryWorker()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'history',
          'deliveredAt',
          'signatureMethod',
          'portDuReceivedMethod',
          'lastLocation',
          'codStatus',
          'codPaymentType',
          'codCollectedAt',
          'codCollectedBy',
          'codCaisseEntryId',
          'portStatus',
          'portCollectedBy',
          'portCollectedById',
          'portCollectedAt',
          'signatureToken',
          'signatureTokenCreatedAt',
          'signatureConfirmedAt',
          'returnSignatureToken',
          'returnSignatureTokenCreatedAt',
          'returnSignatureConfirmedAt',
          'deliveryDriverId',
          'deliveryDriverName',
          'deliverySectorId',
          'deliverySectorCode',
          'deliverySectorName',
          'deliveryVehicleId',
          'deliveryVehicleLabel',
          'deliveryAssignedAt',
          'deliveryAssignedBy',
          'deliveryRejectedAt',
          'deliveryRejectedById',
          'deliveryRejectedBy'
        ]);

      // ⚡ Placée EN TÊTE : Firestore arrête l'évaluation après 1000 expressions ; plus bas, cette règle
      // n'était jamais atteinte sur certains colis (« Missing or insufficient permissions » à l'assignation).
      // Assignation livraison locale : seuls les champs livraison sont modifiÃ©s
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deliveryDriverId', 'deliveryDriverName',
          'deliverySectorId', 'deliverySectorCode', 'deliverySectorName',
          'deliveryVehicleId', 'deliveryVehicleLabel',
          'deliveryAssignedAt', 'deliveryAssignedBy'
        ]);

      // 🧾 RÈGLE : Facturier peut marquer un colis comme facturé et corriger le prix / type de port
      allow update: if isFacturier()
        && isNotBlocked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoiced', 'invoiceId', 'invoicedAt', 'price', 'portType']);

      // 💼 RÈGLE PRIORITAIRE : Encaisseur Central peut modifier les champs de gestion centrale
      // Sans vérifier le statut de livraison ni le verrouillage.
      // ⚠️ EXCEPTION : si la mise à jour ne touche QUE les champs de pointage (contrôle /
      // confirmation d'arrivée), elle doit en plus respecter isOwnControlChange() — sinon
      // n'importe quel Encaisseur Central pourrait annuler le pointage d'un collègue.
      allow update: if isCentralCollector()
        && (!touchesOnlyControlFields() || isOwnControlChange());

      // 📅 RÈGLE : Chef d'agence peut corriger la date d'expédition (expeditionDate) et le jour d'opération (workDate)
      allow update: if isChefAgence()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expeditionDate', 'workDate', 'createdAt', 'createdAtOriginal']);

      // 🖐️ RÈGLE : Chef d'agence peut modifier price, portType, codAmount (édition rapide)
      allow update: if isChefAgence()
        && keepsDeliveredStatus()
        && !isParcelLocked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price', 'portType', 'codAmount', 'codMixed', 'codCashAmount']);

      // 💰 RÈGLE : Chef d'agence peut collecter/décollecterports (Port dû et Port payé)
      allow update: if isChefAgence()
        && keepsDeliveredStatus()
        && !isParcelLocked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'portStatus', 'portCollectedBy', 'portCollectedById', 'portCollectedAt', 'portDuReceivedMethod',
          'portReceivedBy', 'portReceivedById', 'portReceivedAt'
        ]);

      // ✅ RÈGLE : Aide-agent peut modifier ses propres colis non validés et non verrouillés
      allow update: if isAideAgent()
        && isParcelCreator()
        && resource.data.validatedByChef != true
        && !isParcelLocked()
        && keepsDeliveredStatus();

      // 🔒 VERROUILLAGE PERMANENT : Si colis a été chargé dans un camion (shipmentLoadedAt existe),
      // SEUL l'admin peut modifier, et ce pour TOUT le reste du parcours
      // (En transit → Arrivé en agence → En livraison → Livré → etc.)

      // Correction du bon: poids/details uniquement, jamais COD/statut.
      // Autorisation volontairement limitee aux champs du bon pour eviter les rejets de role/token.
      // ⭐ RÈGLE PRIORITAIRE : Retour de colis (depuis N'IMPORTE QUEL statut → Retourné)
      // 🔒 VERROUILLAGE : Refusé si colis a été chargé dans un camion (sauf admin via règle globale ci-dessus)
      // Autorise TOUTES les modifications nécessaires pour markParcelAsReturned()
      // ⚠️ Sans la garde ci-dessous, un colis déjà "Retourné" (status inchangé par cette
      // règle) laissait n'importe quel utilisateur signé écraser le pointage Encaisseur
      // Central d'un autre (aucune restriction de champs sur cette règle).
      allow update: if signedIn()
        && request.resource.data.status == 'Retourné'
        && !isParcelLocked()
        && (!touchesOnlyControlFields() || isOwnControlChange());
      // ⭐ RÈGLE : Réessayer livraison (Retourné → En livraison)
      // Permet de remettre un colis retourné en circulation
      // 🔒 Note: déjà protégé car on ne peut pas avoir "Retourné" ET "En transit" simultanément
      allow update: if signedIn()
        && resource.data.status == 'Retourné'
        && request.resource.data.status == 'En livraison';
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && resource.data.status != 'LivrÃ©'
        && resource.data.status != 'Livr\u00c3\u00a9'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(parcelCorrectionFields())
        && !isParcelLocked();
      // ✏️ Correction complète du bon (modal "Modifier l'expédition" + confirmation après saisie)
      // - Agent : uniquement SES bons ; Chef d'agence / Agent PRO / Chef exploitation : tous.
      // - Jamais après chargement camion (sauf admin, règle globale) ; statut inchangé (hors liste).
      // - COD modifiable seulement tant qu'il n'est pas encaissé.
      // - Type de port réservé aux chefs, jamais pour sortir d'un "port_en_compte".
      // - Colis Livré / Retourné : réservé aux chefs.
      allow update: if isAgentOrChef()
        && isNotBlocked()
        && !isParcelLocked()
        && (isChefAgence() || isParcelCreator())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(parcelBonEditFields())
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['codAmount', 'codAmountHistory', 'codStatus', 'codPaymentType', 'codMixed', 'codCashAmount'])
          || (resource.data.get('codCollectedAt', null) == null
              && (resource.data.get('codStatus', null) == null || resource.data.get('codStatus', null) == 'pending'))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['portType'])
          || (isChefAgence()
              && (resource.data.get('portType', '') != 'port_en_compte'
                  || request.resource.data.get('portType', '') == 'port_en_compte'))
        )
        && (isChefAgence() || (resource.data.status != 'Livré' && resource.data.status != 'Retourné'));
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.auth.uid != resource.data.agentId
        && request.resource.data.validatedByChef == true
        && request.resource.data.validatedById == request.auth.uid
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(aideAgentValidationFields());
      // Chargement camion : seuls les champs transport sont modifiÃ©s
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'chauffeurName', 'chauffeurPhone', 'status',
          'shipmentLoadedAt', 'visibleInDestinationAgency', 'history'
        ]);
      // ⭐ POINTAGE ARRIVAGE : autoriser sans vérifier keepsDeliveredStatus
      // (car le pointage peut se faire même si le colis a un statut particulier)
      allow update: if signedIn()
        && isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'visibleInDestinationAgency', 'destinationArrivedAt',
          'destinationAgentId', 'destinationAgentName', 'arrivedNbColis',
          'chefPointedAt', 'chefPointedBy', 'chefPointedById', 'chefPointedSource',
          'history'
        ]);
      // ⭐ VALIDATION ARRIVÉE RETOUR : validation arrivée colis retourné
      // Autorise mise à jour avec destinationArrivedAt (=validation retour)
      // ⚠️ 'destinationArrivedAt' et 'history' existent déjà sur quasi tout colis déjà arrivé —
      // cette règle ne vérifiant PAS quels champs sont modifiés, elle laissait n'importe quel
      // utilisateur signé écraser le pointage d'un autre sur ces colis. Exclu explicitement.
      // (règle « validation arrivée retour » déplacée en tête du bloc, voir plus haut)
      // RÃ©ception agence : prise en charge et arrivage de colis en transit
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'visibleInDestinationAgency', 'destinationArrivedAt',
          'destinationAgentId', 'destinationAgentName', 'arrivedNbColis',
          'chefPointedAt', 'chefPointedBy', 'chefPointedById', 'chefPointedSource',
          'history'
        ]);
      // ⭐ Staff : générer token de signature (agents, chauffeurs, etc.)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'signatureToken',
          'signatureTokenCreatedAt'
        ]);
      // ⭐ Staff : générer token de signature de retour
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'returnSignatureToken',
          'returnSignatureTokenCreatedAt'
        ]);
      // ⭐ Staff : confirmer signature normale (Livré)
      allow update: if signedIn()
        && request.resource.data.status == 'Livré'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'signatureToken',
          'signatureConfirmedAt',
          'signatureMethod',
          'history'
        ]);
      // ⭐ Staff : confirmer signature de retour (Retour finalisé)
      allow update: if signedIn()
        && request.resource.data.status == 'Retour finalisé'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'returnSignatureToken',
