      // Retour camion : l'agence qui a physiquement le colis retournÃ© peut l'expÃ©dier
      // vers l'agence d'origine, sans toucher aux donnÃ©es sensibles du bon.
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.resource.data.status == 'Retour en transit'
        && (resource.data.status == 'RetournÃ©' || resource.data.status == 'RetournÃ©')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'returnShippedAt',
          'history',
          'sender',
          'receiver',
          'originCity',
          'destinationCity',
          'returnToCity',
          'arrivedNbColis'
        ]);
      // Retour direct depuis l'agence destination ou le livreur assignÃ©.
      // Le bon est inversÃ© pour repartir vers l'expÃ©diteur, sans modifier les champs sensibles hors retour.
      allow update: if signedIn()
        && keepsDeliveredStatus()
        && request.resource.data.status == 'RetournÃ©'
        && resource.data.status != 'RetournÃ©'
        && (
          resource.data.destinationAgentId == request.auth.uid
          || resource.data.deliveryDriverId == request.auth.uid
          || (
            userDoc().city is string
            && (
              userDoc().city == resource.data.destinationCity
              || (resource.data.receiver != null && userDoc().city == resource.data.receiver.city)
            )
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'sender',
          'receiver',
          'originCity',
          'destinationCity',
          'returnToCity',
          'createdByCity',
          'codAmount',
          'returnedAt',
          'returnReason',
          'arrivedNbColis',
          'history',
          'wasReturned',
