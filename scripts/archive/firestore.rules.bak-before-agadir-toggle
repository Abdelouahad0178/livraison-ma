        ]);
      // Pointeur-Encaisseur : rÃ©ception port dÃ» versÃ© par un livreur
      allow update: if isPointeurEncaisseur()
        && keepsDeliveredStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
