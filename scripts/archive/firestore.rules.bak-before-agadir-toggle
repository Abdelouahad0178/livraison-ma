          ]))
        || (isPointeurEncaisseur()
          && resource.data.pointeurId == request.auth.uid
          && resource.data.agencyCity == userDoc().city
          && (resource.data.status == 'en_attente' || resource.data.status == 'encaisse'))
        || ((role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation')) && resource.data.agencyCity == userDoc().city)
        || ((role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation'))
          && resource.data.villeExpedition == userDoc().city
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sourceReceived', 'sourceReceivedAt', 'sourceReceivedBy', 'sourceReceivedById',
            'sourceReceivedMode', 'sourceReceivedMontant', 'sourceReceivedBanque',
            'sourceReceivedNumeroPiece', 'sourceReceivedDateEcheance',
            'sourceDataMatches', 'sourceReceivedNote', 'updatedAt'
          ]));
      allow delete: if isAdmin()
        || (isPointeurEncaisseur()
          && resource.data.pointeurId == request.auth.uid
          && (resource.data.status == 'en_attente' || resource.data.status == 'encaisse'))
        || ((role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation')) && resource.data.agencyCity == userDoc().city);
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Rapports RÃ¨glements
    match /reglementsRapports/{rapportId} {
      allow read: if isAdmin()
        || (isStaff() && isNotBlocked() && (
          resource.data.agencyCity == userCity()
          || resource.data.pointeurId == request.auth.uid
        ));
      allow create: if isAdmin()
        || (isPointeurEncaisseur()
          && request.resource.data.pointeurId == request.auth.uid
          && request.resource.data.agencyCity == userDoc().city);
      allow update: if isAdmin()
        || (isPointeurEncaisseur()
          && resource.data.pointeurId == request.auth.uid
          && resource.data.status == 'brouillon')
        || ((role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation')) && resource.data.agencyCity == userDoc().city);
      allow delete: if isAdmin()
        || (isPointeurEncaisseur()
          && resource.data.pointeurId == request.auth.uid
          && resource.data.status == 'brouillon');
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Retour Documents (bordereaux de retour chÃ¨ques/traites)
    match /retourDocuments/{id} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (isPointeurEncaisseur()
          && request.resource.data.pointeurId == request.auth.uid
          && request.resource.data.agencyCity == userDoc().city);
      allow update: if isAdmin()
        || (isPointeurEncaisseur() && resource.data.agencyCity == userDoc().city)
        || ((role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation')) && resource.data.agencyCity == userDoc().city);
      allow delete: if isAdmin()
        || (isPointeurEncaisseur()
          && resource.data.pointeurId == request.auth.uid
          && resource.data.status == 'brouillon');
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Versements bancaires (RETOUR FOND)
    match /bankDeposits/{depositId} {
      allow read:          if isStaff();
      allow create:        if isStaff();
      allow update, delete: if isAdmin();
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Notes agents
    match /agentNotes/{noteId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Stats agrÃ©gÃ©es (Ã©crites par Cloud Functions, lues par admin)
    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only (service account bypasses rules)
    }
    match /stats/{statId}/{sub=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ã¢â€â‚¬Ã¢â€â‚¬ Catch-all : lecture staff, Ã©criture admin uniquement
    // (protÃ¨ge les collections non listÃ©es explicitement)
    // Encaisseur central : versements societe et paiements fournisseurs
    match /centralCodDeposits/{depositId} {
      allow read: if isAdmin() || isCentralCollector() || role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation');
      allow create: if isAdmin() || role() == 'chef_agence' || (role() == 'agentpro' || role() == 'chef_exploitation');
      allow update: if isAdmin() || isCentralCollector();
      allow delete: if isAdmin();
    }

    match /centralSupplierPayments/{paymentId} {
      allow read, create, update: if isAdmin() || isCentralCollector();
      allow delete: if isAdmin();
    }

    // Comptes portail (particuliers et clients)
    match /portalAccounts/{accountId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == accountId);
      // Création : staff OU utilisateur créant son propre compte (accountId = uid)
      allow create: if isStaff()
        || (signedIn() && request.auth.uid == accountId && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff() || (signedIn() && request.auth.uid == accountId);
      allow delete: if isStaff();
    }

    // Déclarations de colis perdus
    match /lostParcels/{lostParcelId} {
      allow read: if isStaff() || isDeliveryWorker();
      // Création : tout le staff ET les chauffeurs/livreurs peuvent déclarer un colis perdu
      allow create: if (isStaff() || isDeliveryWorker()) && signedIn();
      // Mise à jour : réponses des agences, changements de statut
      allow update: if isStaff();
      // Suppression : admin, chef d'agence, ou déclarateur original
      allow delete: if isAdmin()
        || role() == 'chef_agence' || role() == 'agentpro'
        || (signedIn() && resource.data.declaredBy.uid == request.auth.uid);
    }

    // Transactions de ports dûs en compte clients
    match /clientPortDuTransactions/{transactionId} {
      // Lecture : Staff et livreurs
      allow read: if isStaff() || isDeliveryWorker();
      // Création : Staff et livreurs
      allow create: if signedIn() && (isStaff() || isDeliveryWorker());
      // Mise à jour : Admin, chef d'agence et agentpro de la même ville
      allow update: if isAdmin()
        || (isChefAgence() && resource.data.agencyCity == userCity());
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
    }

    // Bons de livraison (Delivery Sheets)
    match /deliverySheets/{sheetId} {
      // Lecture : Staff de la même ville ou admin
      allow read: if isStaff() && (isAdmin() || resource.data.agencyCity == userCity());
      // Création : Chef d'agence et agentpro uniquement
      allow create: if signedIn() && isChefAgence()
        && request.resource.data.agencyCity == userCity()
        && request.resource.data.createdById == request.auth.uid;
      // Mise à jour : Admin ou chef d'agence de la même ville
      allow update: if isAdmin()
        || (isChefAgence() && resource.data.agencyCity == userCity());
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // DISTRIBUTION RETOUR DE FOND ESPECES (DRFE)
    // ═══════════════════════════════════════════════════════════════════════════
    match /return_funds_especes/{docId} {
      // Lecture : Distributeur espèces ou Admin
      allow read: if isDistributeurEspeces() || isAdmin();
      // Création : Distributeur espèces ou Admin
      allow create: if isDistributeurEspeces() || isAdmin();
      // Mise à jour : Distributeur espèces ou Admin
      allow update: if isDistributeurEspeces() || isAdmin();
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // DISTRIBUTION RETOUR DE FOND CHEQUES/TRAITES (DRFC)
    // ═══════════════════════════════════════════════════════════════════════════
    match /return_funds_cheques/{docId} {
      // Lecture : Distributeur chèques ou Admin
      allow read: if isDistributeurCheques() || isAdmin();
      // Création : Distributeur chèques ou Admin
      allow create: if isDistributeurCheques() || isAdmin();
      // Mise à jour : Distributeur chèques ou Admin
      allow update: if isDistributeurCheques() || isAdmin();
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // VERSION ALLÉGÉE DES EXPÉDITIONS (parcelsLite) — miroir de parcels sans les champs lourds
    // ═══════════════════════════════════════════════════════════════════════════
    // Écrit UNIQUEMENT par la Cloud Function syncParcelLite (Admin SDK) : aucune écriture client.
    // Lecture : staff (dont facturier) — jamais plus large que parcels (pas de get public).
    // ⚠️ Bloc séparé : le bloc parcels est proche de la limite de 1000 expressions.
    match /parcelsLite/{parcelId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // ARCHIVES COLIS (parcels_archive)
    // ═══════════════════════════════════════════════════════════════════════════
    match /parcels_archive/{parcelId} {
      // Lecture : tout le staff + encaisseur central
      allow read: if isStaff() || isCentralCollector();
      // Création : admin uniquement (archivage automatique)
      allow create: if isAdmin();
      // Mise à jour : admin ou encaisseur central (pour restauration)
      allow update: if isAdmin() || isCentralCollector();
      // Suppression : admin ou encaisseur central (pour restauration)
      allow delete: if isAdmin() || isCentralCollector();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // FACTURATION (invoices)
    // ═══════════════════════════════════════════════════════════════════════════
    match /invoices/{invoiceId} {
      // Lecture : Admin, Facturier, ou Chef d'agence de la même ville
      allow read: if isAdmin() || isFacturier()
        || (isChefAgence() && resource.data.agencyCity == userCity());
      // Création : Admin, Facturier, ou Chef d'agence
      allow create: if isAdmin() || isFacturier() || isChefAgence();
      // Mise à jour : Admin, Facturier, ou Chef d'agence de la même ville
      allow update: if isAdmin() || isFacturier()
        || (isChefAgence() && resource.data.agencyCity == userCity());
      // Suppression : Admin ou Facturier uniquement
      allow delete: if isAdmin() || isFacturier();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // RETARDS DE LIVRAISON (deliveryDelays)
    // ═══════════════════════════════════════════════════════════════════════════
    match /deliveryDelays/{delayId} {
      // Lecture : Admin, Chef d'agence, AgentPro, ou créateur du retard
      allow read: if isAdmin()
        || isChefAgence()
        || (signedIn() && request.auth.uid == resource.data.createdById);
      // Création : Chef d'agence ou AgentPro uniquement
      allow create: if signedIn() && isChefAgence()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.city == userCity();
      // Mise à jour : Admin, Chef d'agence, AgentPro de la même ville, ou créateur
      allow update: if isAdmin()
        || (isChefAgence() && resource.data.city == userCity())
        || (signedIn() && request.auth.uid == resource.data.createdById);
      // Suppression : Admin ou Chef d'agence de la même ville
      allow delete: if isAdmin()
        || (isChefAgence() && resource.data.city == userCity());
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 👁️ PRÉSENCE TEMPS RÉEL (presence/{uid}) — « L'œil qui ne dort pas » (Admin)
    // Chaque utilisateur n'écrit QUE sa propre fiche (heartbeat). Lecture : Admin/Directeur
    // (+ l'utilisateur lui-même pour la remise à zéro quotidienne des compteurs).
    // Bloc séparé (hors /parcels) : pas d'impact sur la limite d'expressions des colis.
    // ═══════════════════════════════════════════════════════════════════════════
    match /presence/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdminOrDirecteur());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'role', 'city', 'currentPage', 'pageLabel', 'tab',
          'online', 'visible', 'lastSeen', 'idleSec', 'lastActivityAt', 'sessionStart',
          'device', 'day', 'firstSeenToday', 'activity15', 'activityMinute',
          'actionsToday', 'parcelsCreatedToday', 'parcelsUpdatedToday', 'codCollectedToday'
        ]);
      allow delete: if isAdmin();
    }

    // Règle par défaut — la collection presence est exclue (lecture réservée Admin/Directeur ci-dessus)
    match /{coll}/{document=**} {
      allow read:  if coll != 'presence' && isStaff();
      // parcelsLite : écrit uniquement par la Cloud Function syncParcelLite (Admin SDK)
      allow write: if coll != 'presence' && coll != 'parcelsLite' && isAdmin();
    }
  }
}
