      allow update: if isStaff() && keepsDeliveredStatus()
        && (!touchesOnlyControlFields() || isOwnControlChange())
        && (
        isAdmin()
        || isChefOfAideAgentParcelAgency()
        || (
          // Retour : tout le staff peut inverser expÃ©diteur/destinataire
          request.resource.data.status == 'RetournÃ©'
          && resource.data.status != 'RetournÃ©'
          && !isAideAgent()
