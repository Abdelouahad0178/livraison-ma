          // Chargement retour sur camion inter-villes
          request.resource.data.status == 'Retour en transit'
          && resource.data.status == 'RetournÃ©'
          && !isAideAgent()
        )
        || (
          // Aide agent : modification de ses propres saisies non validÃ©es
          isAideAgent()
          && isParcelCreator()
          && (resource.data.validatedByChef != true || resource.data.aideEditUnlocked == true)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(aideAgentValidationFields())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'codAmount', 'codMixed', 'codCashAmount'])
        )
        || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['codAmount', 'codMixed', 'codCashAmount'])
